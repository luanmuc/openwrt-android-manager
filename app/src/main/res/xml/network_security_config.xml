<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- 允许明文流量，用于局域网路由器访问 -->
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
            <certificates src="user" />
        </trust-anchors>
    </base-config>

    <!-- 调试模式下允许所有证书（仅用于开发） -->
    <debug-overrides>
        <trust-anchors>
            <certificates src="system" />
            <certificates src="user" />
        </trust-anchors>
    </debug-overrides>
</network-security-config>
